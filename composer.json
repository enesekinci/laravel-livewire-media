{
    "name": "enesekinci/laravel-livewire-media",
    "description": "R2/S3 media library picker for Laravel Livewire (upload, browse, select).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livewire", "media", "r2", "s3", "file-manager", "picker"],
    "authors": [
        {
            "name": "Enes Ekinci",
            "email": "enesekinci@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "EnesEkinci\\Media\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EnesEkinci\\Media\\MediaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
